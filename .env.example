APP_ENV=development
APP_NAME=D-carbN Carbon Platform
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_AUDIENCE=dcarbn-carbon-platform
DATABASE_URL=postgresql+asyncpg://dcarbn:dcarbn@postgres:5432/dcarbn
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DOCS_ENABLED=true
HSTS_ENABLED=false
REDIS_REQUIRED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1,::1
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_FAILURE_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example.com
