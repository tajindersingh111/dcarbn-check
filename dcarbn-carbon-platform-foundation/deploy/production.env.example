FRONTEND_BASE_URL=https://carbon.example.com
NEXT_PUBLIC_API_BASE_URL=https://carbon.example.com/api/v1
CORS_ORIGINS=https://carbon.example.com
TRUSTED_HOSTS=carbon.example.com
TRUSTED_PROXY_IPS=172.16.0.0/12

EMAIL_FROM_ADDRESS=no-reply@carbon.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=dcarbn
REDIS_PASSWORD=replace-with-random-password

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
BACKUP_RETENTION_DAYS=35
BACKUP_SCHEDULE_SECONDS=86400
BACKUP_MAX_AGE_SECONDS=93600
BACKUP_REMOTE=
RCLONE_CONFIG_PATH=./deploy/backup/rclone.conf.example

GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=https://grafana.example.com
ALERT_EMAIL_TO=operations@example.com
ALERT_EMAIL_FROM=alerts@example.com
ALERT_FORWARD_WEBHOOK_URL=

RESTORE_DRILL_SCHEDULE_SECONDS=2592000

DCARBN_REGION=primary
WAL_ARCHIVE_REMOTE=backups-primary:dcarbn-primary
WAL_ARCHIVE_SECONDARY_REMOTE=backups-secondary:dcarbn-secondary
WAL_ARCHIVE_MAX_AGE_SECONDS=300
PITR_REMOTE=backups-primary:dcarbn-primary
PITR_SECONDARY_REMOTE=backups-secondary:dcarbn-secondary
PITR_BASE_BACKUP_RETENTION_DAYS=14
PITR_BASE_BACKUP_SCHEDULE_SECONDS=86400
PITR_BASE_BACKUP_ID=
PITR_TARGET_TIME=
PITR_TARGET_LSN=
PITR_TARGET_XID=
PITR_TARGET_NAME=
PITR_TARGET_TIMELINE=latest
PITR_TARGET_ACTION=pause
PITR_CONFIRMATION=
FAILOVER_STATUS_INTERVAL_SECONDS=30

MAX_FAILOVER_EVIDENCE_AGE_DAYS=90
RELEASE_VERSION=
RELEASE_COMMIT_SHA=
RELEASE_IMAGE_REFERENCES=
PROMETHEUS_URL=http://prometheus:9090
READINESS_URL=http://backend:8000/api/v1/health/ready
RECOVERY_READINESS_URL=http://backend:8000/api/v1/health/recovery-readiness
CHAOS_SCENARIO=backend_pause
CHAOS_DURATION_SECONDS=60
CHAOS_CONFIRMATION=
FAILOVER_EXERCISE_MODE=dry-run
FAILOVER_EXERCISE_CONFIRMATION=
