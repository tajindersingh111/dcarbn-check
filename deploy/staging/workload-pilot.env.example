# Controlled workload pilot — staging configuration template
#
# Purpose: deploy the approved pilot controls in a dark, non-processing state.
# Copy these values into the protected staging configuration store. Do not use
# this repository file as the live environment file.
#
# Never commit the pilot tenant UUID, credentials, tokens, customer data,
# methodology-pack approval evidence or personal contact details.

APP_ENV=staging

# Safe deployment state. Both values remain false until the staging checklist
# has a signed GO decision and the change is applied during the approved window.
ASYNC_WORKLOADS_ENABLED=false
METHODOLOGY_PACKS_ENABLED=false

# Populate exactly one approved tenant UUID in the protected configuration store.
# Leave empty in source control. The application fails closed if asynchronous
# workloads are enabled while this value is empty or malformed.
ASYNC_WORKLOAD_ALLOWED_TENANT_IDS=

# The only reviewed pilot workload type.
ASYNC_WORKLOAD_ALLOWED_TYPES=calculation

# Initial conservative worker limits. Change only through a reviewed capacity
# decision supported by retained workload-capacity evidence.
WORKER_LEASE_SECONDS=60
WORKER_PER_TENANT_LIMIT=2

# Staging should use its managed Redis instance and fail closed if Redis is
# unavailable. Connection strings belong in protected configuration.
REDIS_REQUIRED=true

# Retain secure staging defaults. Complete values such as trusted hosts, proxy
# addresses and origins in the hosting-specific protected configuration.
COOKIE_SECURE=true
HSTS_ENABLED=true
DOCS_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=false
