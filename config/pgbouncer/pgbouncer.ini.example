; Render placeholders from protected configuration. This file contains no endpoint,
; user name, password or customer identifier.

[databases]
dcarbn = host=<database-host> port=<database-port> dbname=<database-name>

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = 6432
pool_mode = transaction
auth_type = scram-sha-256
auth_file = /run/secrets/pgbouncer_userlist
client_tls_sslmode = verify-full
client_tls_key_file = /run/secrets/pgbouncer_client_tls_key
client_tls_cert_file = /run/secrets/pgbouncer_client_tls_cert
client_tls_ca_file = /run/secrets/pgbouncer_client_tls_ca
server_tls_sslmode = verify-full
server_tls_key_file = /run/secrets/pgbouncer_postgresql_tls_key
server_tls_cert_file = /run/secrets/pgbouncer_postgresql_tls_cert
server_tls_ca_file = /run/secrets/postgresql_server_tls_ca
ignore_startup_parameters = extra_float_digits
max_client_conn = 100
default_pool_size = 12
min_pool_size = 0
reserve_pool_size = 2
reserve_pool_timeout = 3
server_connect_timeout = 5
server_login_retry = 5
query_timeout = 30
query_wait_timeout = 5
client_idle_timeout = 300
server_idle_timeout = 300
server_lifetime = 3600
server_reset_query = DISCARD ALL
server_reset_query_always = 1
admin_users = <protected-admin-user>
stats_users = <protected-monitoring-user>
