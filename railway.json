{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway-pilot",
    "watchPatterns": [
      "/local-demo/**",
      "/Dockerfile.railway-pilot",
      "/railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 120
  }
}
