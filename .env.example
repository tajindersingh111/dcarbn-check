APP_ENV=development
APP_NAME=D-carbN Carbon Platform
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_AUDIENCE=dcarbn-carbon-platform
DATABASE_URL=postgresql+asyncpg://dcarbn:dcarbn@postgres:5432/dcarbn
DATABASE_APPLICATION_ROLE=dcarbn_app
# Select api or worker per process. Ordinary processes never run migrations.
DATABASE_PROCESS_ROLE=api
# Set pgbouncer_transaction only when the supplied endpoint uses transaction pooling.
DATABASE_POOL_MODE=direct
DATABASE_CONNECTION_LIMIT=50
DATABASE_SAFETY_MARGIN_PERCENT=40
DATABASE_OPERATOR_RESERVE=5
DATABASE_MONITORING_CONNECTIONS=2
DATABASE_MIGRATION_CONNECTIONS=1
DATABASE_API_REPLICAS=3
DATABASE_API_POOL_SIZE=3
DATABASE_API_MAX_OVERFLOW=1
DATABASE_WORKER_REPLICAS=3
DATABASE_WORKER_POOL_SIZE=2
DATABASE_WORKER_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DOCS_ENABLED=true
HSTS_ENABLED=false
REDIS_REQUIRED=false
ASYNC_WORKLOADS_ENABLED=false
METHODOLOGY_PACKS_ENABLED=false
ASYNC_WORKLOAD_ALLOWED_TENANT_IDS=
ASYNC_WORKLOAD_ALLOWED_TYPES=
WORKER_LEASE_SECONDS=60
WORKER_PER_TENANT_LIMIT=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1,::1
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_FAILURE_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example.com
