STANDBY_REGION=secondary
PITR_SECONDARY_REMOTE=backups-secondary:dcarbn-secondary
WAL_ARCHIVE_SECONDARY_REMOTE=backups-secondary:dcarbn-secondary
WAL_ARCHIVE_REMOTE=backups-primary:dcarbn-primary
RCLONE_CONFIG_PATH=./deploy/backup/rclone.conf.example

STANDBY_PREPARE_CONFIRMATION=
STANDBY_RECOVERY_DELAY=0
STANDBY_REDIS_PASSWORD=replace-with-random-password
STANDBY_DATABASE_URL=postgresql://dcarbn:<password>@standby-postgres:5432/dcarbn
FAILOVER_STATUS_INTERVAL_SECONDS=30

PRIMARY_HEALTH_URL=https://primary.example.com/api/v1/health/ready
FAILOVER_CONFIRMATION=
FAILOVER_MAX_REPLAY_LAG_SECONDS=30
FAILOVER_REPLAY_TIMEOUT_SECONDS=300
PRIMARY_FENCING_HOOK_PATH=./deploy/failover/fencing-hook.example.sh
ROUTING_FAILOVER_HOOK_PATH=./deploy/failover/routing-hook.example.sh

STANDBY_FRONTEND_BASE_URL=https://secondary.example.com
STANDBY_API_BASE_URL=https://secondary.example.com/api/v1
STANDBY_CORS_ORIGINS=https://secondary.example.com
STANDBY_TRUSTED_HOSTS=secondary.example.com
STANDBY_GATEWAY_PORT=8081

EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=dcarbn
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
TRUSTED_PROXY_IPS=172.16.0.0/12
