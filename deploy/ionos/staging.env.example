# Copy to deploy/ionos/staging.env on the IONOS server.
# Never commit the populated staging.env file.

STAGING_DOMAIN=staging.scope.d-carbnanalytics.com
ACME_EMAIL=operations@example.com

EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=replace-me
SMTP_USE_TLS=true

TRUSTED_PROXY_IPS=172.16.0.0/12
OTEL_ENABLED=false

# Controlled database migration release. Replace RELEASE_SHA during deployment.
RELEASE_SHA=0000000000000000000000000000000000000000
MIGRATION_APPROVED=false
MIGRATION_TARGET=0022
MIGRATION_PHASE=contract
MIGRATION_TIMEOUT_SECONDS=600
MIGRATION_LOCK_TIMEOUT_SECONDS=30
